    <stdin>4.0 5.0</stdin>
    <tests>
import static org.junit.Assert.*;
import org.junit.*;
import java.io.*;

public class RunestoneTests extends CodeTestHelper
{
    public RunestoneTests() {
        //super("Main", input1.replaceAll(" ", "\n")); // For Book
        //super("MyShape", input3.replaceAll(" ", "\n")); // For Repl.it

        length = (int) (Math.random() * 10 + 5);
        width = (int) (Math.random() * 10 + 5);
    }

    private static int goal = 1;
    private static String input1 = "4.0 5.0";
    private static String input2 = "10.0 3.0";
    private static String input3 = "2.0 3.0";
    private String output1, output2;

    private double length, width;


    @Test
    public void test1()
    {
        String input = input1.replaceAll(" ", "\n");
        String output = getMethodOutputWithInput("main", input);

        String expect = "Perimeter = 18.0\nArea = 20.0";

        boolean passed = output.contains("18.0") &amp;&amp; output.contains("20.0") ;

        getResults(expect, output, "Expected calculation for inputs " + input1, passed);
        assertTrue(passed);
    }

    @Test
    public void test2()
    {
        String input = input2.replaceAll(" ", "\n");
        String output = getMethodOutputWithInput("main", input);

        String expect = "Perimeter = 26.0\nArea = 30.0";

        boolean passed = output.contains("26.0") &amp;&amp; output.contains("30.0") ;

        getResults(expect, output, "Expected calculation for inputs " + input2, passed);
        assertTrue(passed);
    }


    @Test
    public void test3()
    {
        String code = getCode();
        boolean created = countOccurences(code, "new Scanner(System.in)") == 1;
        int num = countOccurences(code, ".nextDouble()");
        boolean called = num == 2;

        String output = "Created: " + created + "\nCalled: " + num + " times";
        String expected = "Created: " + true + "\nCalled: " + 2 + " times";

        boolean passed = created &amp;&amp; called;
        getResults(expected, output, "Used Scanner correctly", passed);
        assertTrue(passed);
    }

    @Test
    public void test4()
    {
        String code = getCode();
        String output = "no matching method declared";
        String expect = "static void perimeter(...)";
        boolean passed = false;

        String[] lines = code.split("\n");

        for (String line: lines) {
            if (line.contains("public") &amp;&amp; line.contains("perimeter")) {
                output = line;
                if (line.contains("static void perimeter")) {
                    passed = true;
                    break;
                }
            }
        }


        getResults(expect, output, "Perimeter method declared properly", passed);
        assertTrue(passed);
    }

    @Test
    public void test5()
    {
        String code = getCode();
        boolean header = false, ret = false;
        String hdr = "none", retn = "none";

        String[] lines = code.split("\n");

        for (String line : lines) {
            if (line.contains("public") &amp;&amp; line.contains("area")) {
                if (line.contains("static double area")) {
                    header = true;
                    hdr = line;
                }
            }
            if (line.contains("return")) {
                ret = true;
                retn = line;
            }
        }

        boolean passed = header &amp;&amp; ret;

        String output = "Header: " + hdr + "\nReturn: " + retn;
        String expect = "Header: public static double area(double l, double w)" + "\nReturn: " + "return l * w;";

        getResults(expect, output, "Area method declared properly and returns a value", passed);
        assertTrue(passed);
    }

    @Test
    public void test6()
    {
        String code = getCode();
        int area = -1, perimeter = -1;
        String areaH = "none", perimH = "none";

        String[] lines = code.split("\n");

        for (String line: lines) {
            if (line.contains("public") &amp;&amp; line.contains("area")) {
                area = numParameters(line);
                areaH = line;
            }
            if (line.contains("public") &amp;&amp; line.contains("perimeter")) {
                perimeter = numParameters(line);
                perimH = line;
            }
        }

        boolean passed = area == 2 &amp;&amp; perimeter == 2;

        String output = "Perimeter: " + perimH + " (" + perimeter + " parameters)\nArea: " + areaH + " (" + area + " parameters)";
        String expect = "Perimeter: perimeter(double l, double w)\nArea: area(double l, double w)";

        getResults(expect, output, "Methods both have 2 parameters each", passed);
        assertTrue(passed);
    }

    private int numParameters(String line) {
        if(line.contains("(") &amp;&amp; line.contains(")")) {
            line = line.substring(line.indexOf("(") + 1, line.indexOf(")"));
            return line.split(",").length;
        }
        return 0;
    }

    @Test
    public void test7()
    {
        String code = getCode();
        String area = "none", perimeter = "none";
        int areaNum = -1, perimNum = -1;

        String[] lines = code.split("\n");

        for (String line: lines) {
            if (line.contains("area") &amp;&amp; !line.contains("static") &amp;&amp; !line.contains("System")) {
                area = line;
                areaNum = numParameters(line);
            }
            if (perimeter == "none" &amp;&amp; line.contains("perimeter") &amp;&amp; !line.contains("static")  &amp;&amp; !line.contains("System")) {
                perimeter = line;
                perimNum = numParameters(line);
            }
        }

        boolean passed = areaNum == 2 &amp;&amp; perimNum == 2;

        String output = "Perimeter: " + perimeter + " (" + perimNum + " parameters)\nArea: " + area + " (" + areaNum + " parameters)";
        String expect = "Perimeter: perimeter(length, width) (2 parameters)\nArea: area(length, width) (2 parameters)";

        getResults(expect, output, "Perimeter and Area methods have been called properly", passed);
        assertTrue(passed);
    }


    @Test
    public void test8()
    {
        String code = getCode();
        int num = countOccurences(code, "System.out.println(");

        boolean passed = num &gt;= 2;
        getResults("2 times", num + " times", "Called System.out.println(...) enough times", passed);
        assertTrue(passed);
    }

    @Test
    public void test9() {
        Object[] args = {length, width};
        String ans = getMethodOutput("perimeter", args);
        double exp = 2 * length + 2 * width;

        boolean passed = getResults("" + exp, "" + ans, "Correct calculation for perimeter with inputs " + length + " and " + width);
        assertTrue(passed);
    }

    @Test
    public void test10() {
        Object[] args = {length, width};
        String ans = getMethodOutput("area", args);
        double exp = length * width;

        boolean passed = getResults("" + exp, "" + ans, "Correct calculation for area with inputs " + length + " and " + width);
        assertTrue(passed);
    }
}

    </tests>
    </program>
</activity>

</subsection>

<subsection xml:id="unit1b-project2-static-methods">
    <title>Static Methods Review</title>
    
<p>
    A static method belongs to the class, not to an individual object. Because of this, you do not need to create an object before calling a static method. 
</p>
<p>
    To call a static method in the same class, simply use its name:  <c>printGreeting( );</c>
</p>
<p>
    To call a static method from another class, use the class name followed by a dot (.):  <c>Math.sqrt(25);</c>
</p>
<p>
    You will find the name of the class in the class header:  <c>public class Math</c>
</p>

<p>
    Remember:
</p>

<ul>
    <li>Static methods belong to the class.</li>
    <li>You can call a static method without creating an object.</li>
    <li>If the method is in another class, use <c>ClassName.methodName(...)</c></li>
    <li>Provide the required arguments in the correct order and type when calling the method.</li>
</ul>

<activity label="unit1b-projects-choose4">
<statement>
    <p>The following method is defined in a class named Geometry.</p>
<program language="java">
<code>

public class Geometry
{
    public static double findArea(double length, double width)
    {
        return length * width;
    }
}
</code>
</program>
  
    <p>Which of the following correctly calls the findArea method from another class and stores the result in a variable?</p>
</statement>
<choices>
<choice ><statement><p><c>double area = findArea(8.5, 4.0);</c></p></statement><feedback><p>Since this call is being made from another class, what must be included before the method name?</p></feedback></choice>
<choice ><statement><p><c>double area = Geometry.findArea( );</c></p></statement><feedback><p>Compare the number of arguments in the method call to the number of parameters in the method header.</p></feedback></choice>
<choice ><statement><p><c>int area = Geometry.findArea(8, 12);</c></p></statement><feedback><p>What type of value does the method return?</p></feedback></choice>
<choice correct="yes"><statement><p><c>double area = Geometry.findArea(8.5, 4.0);</c></p></statement><feedback><p>Because findArea is a static method in the Geometry class, it is called using the class name, a dot (.), and the method name. The method requires two arguments (length and width) and returns a double, which is stored in the variable area.</p></feedback></choice>
</choices>
</activity>

</subsection>

<subsection xml:id="unit1b-project2">
<title>Unit 1B Project 2 - Round Things</title>

<p>
Write a Java program that calculates and displays the area and circumference of a circle and the volume and surface area of a sphere.  You will be writing two classes for this program.  One will use the RoundThingsDriver class and the other will use the RoundThings class.
</p>
<p>
<term>Class Name: RoundThings</term>
</p>

<p>
There will not be a main method in this class. This class will just have four methods.
</p>

<p>
<em>Methods</em>
</p>
<p>
All these methods will be static. Use Math.PI for pi. The radius parameter will be a double value.
</p>

<ol>
<li>
    <c>calcAreaCircle()</c> - receives the radius of a circle, and returns the area
</li>
<li>
    <c>calcCircumCircle()</c> - receives the radius of a circle and returns the circumference
</li>
<li>
    <c>calcAreaSphere()</c> - receives the radius of a Sphere and returns the area
</li>
<li>
    <c>calcVolumeSphere()</c> - receives the radius of a Sphere and returns the volume - watch out for integer division!
</li>
</ol>

<p><term>Class Name: RoundThingsDriver</term></p>

<p>
This will have a main method and will call on methods from <c>RoundThings</c>.
</p>

<p><em>Variables:</em></p>
<ol>
<li><c>radius</c> - input variable, a double value (to be gotten from the user using a Scanner)</li>
<li><c>area</c> - a double value returned from the <c>calcAreaCircle</c> method</li>
<li><c>circumference</c> - a double value returned from the <c>calcCircumCircle</c> method</li>
<li><c>surfaceArea</c> - a double value returned from the <c>calcAreaSphere</c> method</li>
<li><c>volume</c> - a double value returned from the <c>calcVolumeSphere</c> method</li>
</ol>
    

<p>
<em>Processing:</em> In main, declare all variables listed above and create a Scanner object.  
Prompt the user to enter a value for the radius and store that value into the appropriate variable.  
Call the methods you wrote in RoundThings and store the results into the appropriate variables.  
</p>

<p>
<em>Method:</em> <c>outPut</c> - This method will receive 4 values as parameters: a description of the type of value calculated (i.e. circumference, area, volume, surface area), one for the shape name (i.e. circle or sphere), one for the radius inputted by the user, and one for the actual value calculated. It will display (print) the information formatted nicely (see below).
</p>

<program language="java">
<code>
The area of a circle with a radius of # is #.
The volume of a sphere with a radius of # is #. 
(# will be replaced by the appropriate value)
</code>
</program>

<p>
   In main, call the outPut method four times. The first time should be for the area of a circle. The second time should be for the circumference of a circle. The third time should be for the surface area of a sphere.  The fourth time should be for the volume of a sphere. They should all use the same radius value. 
</p>

    <activity label="unit1b-project2-roundthings">
    <statement>
    <p></p>
    </statement>

    <program interactive="activecode" language="java">
    <code>
import java.util.Scanner;


public class RoundThingsDriver{
    public static void main(String[] args)
    {


    }


    public static void outPut(String typeOfValue, String shape, double radius, double calculatedValue)
    {
           // write the code for the body of the outPut method below


    }
}


class RoundThings
{
     // write the four methods for the RoundThings class below


}
    </code>
    <stdin>5.0</stdin>
    <tests>
import static org.junit.Assert.*;
import org.junit.*;
import java.io.*;

public class RunestoneTests extends CodeTestHelper
{
    public RunestoneTests() {
        //super("Main", input1.replaceAll(" ", "\n")); // For Book
        //super("RoundThingsDriver", input3.replaceAll(" ", "\n")); // For Repl.it

        radius = (int) (Math.random() * 10 + 5);
    }

    private static String input1 = "5.0";
    private static String input2 = "7.0";
    private static String input3 = "10.0";

    private double radius;


    @Test
    public void test1()
    {
        String input = input1.replaceAll(" ", "\n");
        String output = getMethodOutputWithInput("main", input);

        String expect = "area = 78.53981633, circumference = 31.415926, surface area = 314.15926, volume = 523.59877".replaceAll(", ","\n");

        boolean passed = output.contains("78.53981633");
        passed = passed &amp;&amp; output.contains("31.415926");
        passed = passed &amp;&amp; output.contains("314.15926");
        passed = passed &amp;&amp; output.contains("523.59877");

        getResults(expect, output, "Expected calculation for input " + input1, passed);
        assertTrue(passed);
    }

    @Test
    public void test2()
    {
        String input = input2.replaceAll(" ", "\n");
        String output = getMethodOutputWithInput("main", input);

        String expect = "area = 153.93804, circumference = 43.982297, surface area = 615.75216, volume = 1436.75504".replaceAll(", ","\n");

        boolean passed = output.contains("153.93804");
        passed = passed &amp;&amp; output.contains("43.982297");
        passed = passed &amp;&amp; output.contains("615.75216");
        passed = passed &amp;&amp; output.contains("1436.75504");

        getResults(expect, output, "Expected calculation for input " + input2, passed);
        assertTrue(passed);
    }


    @Test
    public void test3()
    {
        String code = getCode();
        int num = countOccurences(code, "class RoundThings");

        boolean passed = num == 2;
        getResults("Classes: " + 2, "Classes: " + num, "Two classes created", passed);
        assertTrue(passed);
    }

    @Test
    public void test4()
    {
        String code = getCode();
        int num = countOccurences(code, "public static double");
        String output = "public static double methods: " + num;
        String expect = "public static double methods: " + 4;

        boolean passed = num == 4;
        getResults(expect, output, "4 static double methods created", passed);
        assertTrue(passed);
    }

    @Test
    public void test5()
    {
        String code = getCode();
        boolean created = countOccurences(code, "new Scanner(System.in)") == 1;
        int num = countOccurences(code, ".nextDouble()");
        boolean called = num == 1;

        String output = "Created: " + created + "\nCalled: " + num + " time";
        String expected = "Created: " + true + "\nCalled: " + 1 + " time";

        boolean passed = created &amp;&amp; called;
        getResults(expected, output, "Used Scanner correctly", passed);
        assertTrue(passed);
    }



    @Test
    public void test6()
    {
        String code = getCode();
        int param = -1;
        String header = "no header found";

        String[] lines = code.split("\n");

        for (String line: lines) {
            if (line.contains("static") &amp;&amp; line.contains("outPut")) {
                param = numParameters(line);
                header = line;
                break;
            }
        }

        boolean passed = param == 4 &amp;&amp; !header.equals("no header found");

        String output = header + " (" + param + ")";
        String expect = "public static void outPut (...) (4 parameters)";

        getResults(expect, output, "outPut method declared properly with four parameters", passed);
        assertTrue(passed);
    }

    private int numParameters(String line) {
        if(line.contains("(") &amp;&amp; line.contains(")")) {
            line = line.substring(line.indexOf("(") + 1, line.indexOf(")"));
            return line.split(",").length;
        }
        return 0;
    }

    @Test
    public void test7() {
        String code = getCode();
        int num = 0;

        String[] lines = code.split("\n");

        for (String line: lines) {
            if (line.contains("outPut") &amp;&amp; !line.contains("static")) {
                if (numParameters(line) == 4) {
                    num++;
                }
            }
        }

        boolean passed = num == 4;
        getResults("4 times", num + " times", "Called outPut method 4 times", passed);
        assertTrue(passed);
    }

    @Test
    public void test8() {
        String code = getCode();
        int num = 0;

        String[] lines = code.split("\n");

        for (String line: lines) {
            if (line.contains("RoundThings.")) {
                num++;
            }
        }

        boolean passed = num == 4;
        getResults("4 times", num + " times", "Called static methods properly", passed);
        assertTrue(passed);
    }

    @Test
    public void test9()
    {
        String code = getCode();
        int num = countOccurences(code, "Math.PI");

        boolean passed = num &gt;= 4;
        getResults("4 times", num + " times", "Used Math.PI correct number of times", passed);
        assertTrue(passed);
    }

    @Test
    public void test10()
    {
        String code = getCode();
        int num = countOccurences(code, "System.out.print");

        boolean passed = num &lt;= 2 &amp;&amp; num &gt; 0;
        getResults("2 times", num + " times", "Called System.out.print[ln](...) 2 times maximum", passed);
        assertTrue(passed);
    }


}

    </tests>
    </program>
</activity>

</subsection>

<subsection xml:id="unit1b-project3-string-methods">
    <title>String Methods Review</title>

<p>
    The String class provides many useful methods for working with text. Two of the most common are <c>indexOf()</c> and <c>substring()</c>.
</p>
<p>
    The <c>indexOf()</c> method returns the index of the first occurrence of a character or string. If it is not found, the method returns -1.
</p>
<program language="java">
<code>
String word = "computer";
int index = word.indexOf("p"); // index is 3
</code>
</program>

<p>
    One version of <c>substring()</c> returns a new string starting at a beginning index and continuing to the end of the original string.
</p>
<program language="java">
<code>
String word = "computer";
String part = word.substring(3); // "puter"
</code>
</program>

<p>
    A second version of <c>substring</c> returns the characters from a beginning index up to, but not including, an ending index.
</p>
<program language="java">
<code>
String word = "computer";
String part = word.substring(3, 6); // "put"
</code>
</program>

<p>
    Remember:
</p>
<ul>
<li>String indexing begins at 0.</li>
<li><c>indexOf()</c> returns the first matching index or -1 if not found.</li>
<li><c>substring(beginIndex)</c> goes to the end of the string.</li>
<li><c>substring(beginIndex, endIndex)</c> does not include the character at endIndex.</li>
</ul>

</subsection>


<subsection xml:id="unit1b-project3">
<title>Unit 1B Project 3 - String Program</title>

<p>
<term>StringProgram</term>
</p>
<p>
Write a program that reads in a single String from the user containing exactly four words separated by symbols with no spaces into a single String object. Next, extract each word from the original string and store each word in a String object. Then, concatenate the words in reverse order to form another string. Display both the original and final strings.  
</p>
<p>
Hint: to extract the words, you should use the indexOf ( ) method to find each symbol and then use the substring ( ) method to get the characters between the * symbols.
</p>
<p>
Example output:
</p>
<pre>
Original: one*two*three*four
Reverse: four three two one
</pre>

    <activity label="unit1b-project3-stringprogram">
    <statement>
    <p></p>
    </statement>

    <program interactive="activecode" language="java">
    <code>
import java.util.Scanner;

public class StringProgram{
    public static void main(String[] args)
    {

    }
}

