    @Test
    public void test9()
    {
        String code = getCode();
        int num = countOccurences(code, "String.format(\"%.02f\",");

        boolean passed = num &gt;= 2;
        getResults("2+", num + "", "String.format() used correctly to format the numbers", passed);
        assertTrue(passed);
    }


    @Test
    public void test10()
    {
        String input = input1.replaceAll(" ", "\n");
        String[] lookfor = {"box", "pavillion", "lawn", "fee", "total"};
        String[] expected = {"225", "30", "105", "13.50", "373.50"};
        boolean passed = true;
        String output = "";

        for (int i = 0; i &lt; expected.length; i++){
            String output1 = testInput(input, lookfor[i]);
            output += output1 + "\n";
            passed = passed &amp;&amp; output1.contains(expected[i]);
        }

        String expect = "3\tbox tickets\t\t$225\n1\tpavillion tickets\t\t$30\n5\tlawn tickets\t\t$105\n\tConvenience fee\t\t$13.50\n\tTotal\t\t$373.50";

        getResults(expect, output, "Expected output for input:\n" + input1 + "", passed);
        assertTrue(passed);
    }


    private String testInput(String input, String expect) {
        String actual = "No matching lines";

        String output = getMethodOutputWithInput("main", input);

        String[] lines = output.split("[:?\\n]");

        for (String line: lines) {
            if (line.toLowerCase().contains(expect.toLowerCase())) {
                actual = line;
                break;
            }
        }

        return actual;
    }
}     
</tests>
</program>
