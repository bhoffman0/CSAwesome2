<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="u2b-ct-labeled">
  <title>Unit 2b Subgoal Labeled Puzzles for Toggle Code</title>
  <p>
    These are copies of the Loops Mixed Up Code Practice puzzles with subgoal
    labels added. The Loops Toggle Code Practice page uses them as the Get Help
    puzzles for its write code problems. Each loop header and its opening brace
    are one block, so one label sits on each loop.
  </p>

  <activity label="loopex1muc-sgl" xml:id="loopex1muc-sgl" numbered="yes" adaptive="yes" indentation="hide" language="java">
    <statement>
      <p>
        The following program segment should print out all the values from 20 to
        30 (20, 21, 22, … 30). But, the blocks have been mixed up and include extra blocks that are not needed in a correct solution. Drag the
        blocks from the left and put them in the correct order on the right.
        Click the Check button to check your solution.
      </p>
    </statement>

    <blocks>
      <block order="5">
        <cline>// Start the counter at 20</cline>
        <cline>int x = 20;</cline>
      </block>

      <block order="3">
        <choice correct="yes">
          <cline>// Keep looping while the counter is at most 30</cline>
          <cline>while (x &lt;= 30)</cline>
          <cline>{</cline>
        </choice>
        <choice>
          <cline>// Keep looping while the counter is at most 30</cline>
          <cline>while (x &lt; 30)</cline>
          <cline>{</cline>
        </choice>
        <choice>
          <cline>// Keep looping while the counter is at most 30</cline>
          <cline>while (x &lt;= 30);</cline>
          <cline>{</cline>
        </choice>
      </block>

      <block order="4">
        <cline>    // Print the counter's current value</cline>
        <cline>    System.out.println(x);</cline>
      </block>

      <block order="2">
        <cline>    // Add one to the counter so it moves toward 30</cline>
        <cline>    x++;</cline>
      </block>

      <block order="1">
        <cline>} // end while loop</cline>
      </block>
    </blocks>
  </activity>

  <activity label="loopex2muc-sgl" xml:id="loopex2muc-sgl" numbered="yes" adaptive="yes" indentation="hide" language="java">
    <statement>
      <p>
        The following program segment should print a countdown from 15 to 0 (15,
        14, 13, … 0). But the blocks have been mixed up and include extra blocks that are not needed in a correct solution. Drag the needed blocks
        from the left and put them in the correct order on the right. Click the
        Check button to check your solution.
      </p>
    </statement>

    <blocks>
      <block order="5">
        <cline>public class Test1</cline>
        <cline>{</cline>
      </block>

      <block order="6">
        <cline>    public static void main(String[] args)</cline>
        <cline>    {</cline>
      </block>

      <block order="7">
        <choice correct="yes">
          <cline>        // Use a for loop counting down from 15 to 0 by ones</cline>
          <cline>        for (int i = 15; i &gt;= 0; i--)</cline>
          <cline>        {</cline>
        </choice>
        <choice>
          <cline>        // Use a for loop counting down from 15 to 0 by ones</cline>
          <cline>        for (int i = 15; i &gt; 0; i--)</cline>
          <cline>        {</cline>
        </choice>
        <choice>
          <cline>        // Use a for loop counting down from 15 to 0 by ones</cline>
          <cline>        for (int i = 15; i &lt;= 0; i--)</cline>
          <cline>        {</cline>
        </choice>
      </block>

      <block order="2">
        <cline>            // Print the counter's current value</cline>
        <cline>            System.out.println(i);</cline>
        <cline>        } // end for loop</cline>
      </block>

      <block order="3">
        <cline>    } // end main method</cline>
        <cline>} // end of class</cline>
      </block>
    </blocks>
  </activity>

  <activity label="loopex3muc-sgl" xml:id="loopex3muc-sgl" numbered="yes" adaptive="yes" indentation="hide" language="java">
    <statement>
      <p>
        The main method in the following class should print up from 0 to 50 by 5
        (0, 5, 10, 15 … 50). But, the blocks have been mixed up and include extra blocks that are not needed in a correct solution. Drag the needed blocks
        from the left and put them in the correct order on the right. Click the
        Check button to check your solution.
      </p>
    </statement>

    <blocks>
      <block order="7">
        <cline>public class Test1</cline>
        <cline>{</cline>
      </block>

      <block order="9">
        <cline>    public static void main(String[] args)</cline>
        <cline>    {</cline>
      </block>

      <block order="8">
        <cline>        // Start the counter at 0</cline>
        <cline>        int x = 0;</cline>
      </block>

      <block order="6">
        <choice correct="yes">
          <cline>        // Keep looping while the counter is at most 50</cline>
          <cline>        while (x &lt;= 50)</cline>
          <cline>        {</cline>
        </choice>
        <choice>
          <cline>        // Keep looping while the counter is at most 50</cline>
          <cline>        while (x &lt; 50)</cline>
          <cline>        {</cline>
        </choice>
        <choice>
          <cline>        // Keep looping while the counter is at most 50</cline>
          <cline>        while (x &lt;= 50);</cline>
          <cline>        {</cline>
        </choice>
      </block>

      <block order="1">
        <cline>            // Print the counter's current value</cline>
        <cline>            System.out.println(x);</cline>
      </block>

      <block order="5">
        <choice correct="yes">
          <cline>            // Add 5 to the counter so it moves toward 50</cline>
          <cline>            x = x + 5;</cline>
        </choice>
        <choice>
          <cline>            // Add 5 to the counter so it moves toward 50</cline>
          <cline>            x + 5;</cline>
        </choice>
      </block>

      <block order="3">
        <cline>        } // end while loop</cline>
      </block>

      <block order="4">
        <cline>    } // end main method</cline>
        <cline>} // end of class</cline>
      </block>
    </blocks>
  </activity>

  <activity label="loopex4muc-sgl" xml:id="loopex4muc-sgl" numbered="yes" adaptive="yes" indentation="hide" language="java">
