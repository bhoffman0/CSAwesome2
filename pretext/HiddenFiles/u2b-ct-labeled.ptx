          <cline>       {</cline>
        </choice>
        <choice>
          <cline>       // Use a for loop counting up from 0 to 100 by 20s</cline>
          <cline>       for (int i = 0; i &lt; 100; i+=20)</cline>
          <cline>       {</cline>
        </choice>
      </block>

      <block order="5">
        <cline>           // Print the counter's current value</cline>
        <cline>           System.out.println(i);</cline>
        <cline>       } // end for loop</cline>
      </block>

      <block order="1">
        <cline>    } // end main method</cline>
        <cline>} // end of class</cline>
      </block>
    </blocks>
  </activity>

  <activity label="loopex5muc-sgl" xml:id="loopex5muc-sgl" numbered="yes" adaptive="yes" indentation="hide" language="java">
