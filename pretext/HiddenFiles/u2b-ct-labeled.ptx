        <cline>    {</cline>
      </block>

      <block order="2">
        <choice correct="yes">
          <cline>       // Use a for loop counting up from 0 to 100 by 20s</cline>
          <cline>       for (int i = 0; i &lt;= 100; i+=20)</cline>
