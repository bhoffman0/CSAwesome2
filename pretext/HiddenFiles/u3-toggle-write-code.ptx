      <block>
        <cline>public class BankAccount</cline>
        <cline>{</cline>
      </block>

      <block>
        <cline>    private int balance;</cline>
      </block>

      <block>
        <cline>    public BankAccount(int balance)</cline>
        <cline>    {</cline>
      </block>

      <block>
        <cline>        this.balance = balance;</cline>
      </block>

      <block>
        <cline>    } // end constructor</cline>
