  <activity label="u3_ct_muc1" xml:id="u3_ct_muc1" numbered="yes" adaptive="yes" indentation="hide" language="java">
    <statement>
      <p>
        Write a constructor for the <c>Student</c> class. It takes a <c>name</c> (a <c>String</c>), a <c>grade</c> (an <c>int</c>), and a <c>gpa</c> (a <c>double</c>), in that order, and sets the matching instance variables. Then write a <c>toString</c> method that returns the student's information in the form <c>name (grade grade): gpa</c>, for example <c>Ana (grade 10): 3.8</c>.
        The blocks below are mixed up and include extra blocks that are not
        needed. Drag the needed blocks from the left and put them in order on
        the right, with the right indentation. Click Check to check your
        solution.
      </p>
    </statement>

    <blocks>
      <block>
        <cline>public class Student</cline>
        <cline>{</cline>
      </block>

      <block>
        <cline>    private String name;</cline>
        <cline>    private int grade;</cline>
        <cline>    private double gpa;</cline>
      </block>

      <block>
        <cline>    public Student(String name, int grade, double gpa)</cline>
        <cline>    {</cline>
      </block>

      <block>
        <choice correct="yes">
          <cline>        this.name = name;</cline>
          <cline>        this.grade = grade;</cline>
          <cline>        this.gpa = gpa;</cline>
        </choice>

        <choice>
          <cline>        name = name;</cline>
          <cline>        this.grade = grade;</cline>
          <cline>        this.gpa = gpa;</cline>
        </choice>
      </block>

      <block>
        <cline>    } // end constructor</cline>
      </block>

      <block>
        <cline>    public String toString()</cline>
        <cline>    {</cline>
      </block>

      <block>
        <choice correct="yes">
          <cline>        return name + " (grade " + grade + "): " + gpa;</cline>
        </choice>

        <choice>
          <cline>        System.out.println(name + " (grade " + grade + "): " + gpa);</cline>
        </choice>
      </block>

      <block>
        <cline>    } // end toString</cline>
      </block>

      <block>
        <cline>    public static void main(String[] args)</cline>
        <cline>    {</cline>
      </block>

      <block>
        <cline>        Student s = new Student("Ana", 10, 3.8);</cline>
        <cline>        System.out.println(s);</cline>
      </block>

      <block>
        <cline>    } // end main</cline>
      </block>

      <block>
        <cline>} // end class</cline>
      </block>
    </blocks>
  </activity>

  <exercise label="u3_ct_wc2" xml:id="u3_ct_wc2">
    <statement>
      <p>
        Write a <c>getPrice</c> method for the <c>Ticket</c> class. It returns <c>5</c> if <c>age</c> is under 12, and <c>10</c> otherwise.
      </p>
    </statement>

    <program interactive="activecode" language="java" label="u3_ct_wc2-prog" xml:id="u3_ct_wc2-prog"
             codetailor="all" codetailor-fallback="u3_ct_muc2">
      <code>
public class Ticket
{
    private int age;

    public Ticket(int age)
    {
        this.age = age;
    }

    // YOUR CODE HERE

    public static void main(String[] args)
    {
        System.out.println(new Ticket(8).getPrice());
        System.out.println(new Ticket(12).getPrice());
        System.out.println(new Ticket(40).getPrice());
    }
}
      </code>
      <tests>
import static org.junit.Assert.*;

import org.junit.*;

import java.io.*;

public class RunestoneTests extends CodeTestHelper
{
    public RunestoneTests()
    {
        super("Ticket");
    }

    @Test
    public void testMain()
    {
        String output = getMethodOutput("main");
        String expect = "5\n10\n10";
        boolean passed = getResults(expect, output, "Expected output from main");
        assertTrue(passed);
    }

    @Test
    public void testGetPrice1()
    {
        Object[] args = {11};
        setDefaultValues(args);
        String output = "" + getMethodOutput("getPrice");
        boolean passed = getResults("5", output, "getPrice() with constructor arguments {11}");
        assertTrue(passed);
    }

    @Test
    public void testGetPrice2()
    {
        Object[] args = {65};
        setDefaultValues(args);
        String output = "" + getMethodOutput("getPrice");
        boolean passed = getResults("10", output, "getPrice() with constructor arguments {65}");
        assertTrue(passed);
    }
}

      </tests>
    </program>
  </exercise>

