        <cline>    {</cline>
      </block>

      <block>
        <cline>        this.width = width;</cline>
        <cline>        this.height = height;</cline>
      </block>

      <block>
        <cline>    } // end constructor</cline>
      </block>

      <block>
        <cline>    public int getArea()</cline>
        <cline>    {</cline>
      </block>

      <block>
        <cline>        return width * height;</cline>
      </block>

      <block>
        <cline>    } // end getArea</cline>
      </block>

      <block>
        <choice correct="yes">
          <cline>    public boolean isLargerThan(Rectangle other)</cline>
          <cline>    {</cline>
        </choice>

        <choice>
          <cline>    public boolean isLargerThan()</cline>
          <cline>    {</cline>
        </choice>
      </block>

      <block>
        <choice correct="yes">
          <cline>        return this.getArea() &gt; other.getArea();</cline>
        </choice>

        <choice>
          <cline>        return this.getArea() &gt; other;</cline>
        </choice>
      </block>

      <block>
        <cline>    } // end isLargerThan</cline>
      </block>

      <block>
        <cline>    public static void main(String[] args)</cline>
        <cline>    {</cline>
      </block>

      <block>
        <cline>        Rectangle a = new Rectangle(4, 5);</cline>
        <cline>        Rectangle b = new Rectangle(3, 6);</cline>
        <cline>        System.out.println(a.getArea());</cline>
        <cline>        System.out.println(a.isLargerThan(b));</cline>
        <cline>        System.out.println(b.isLargerThan(a));</cline>
      </block>

      <block>
        <cline>    } // end main</cline>
      </block>

      <block>
        <cline>} // end class</cline>
      </block>
    </blocks>
