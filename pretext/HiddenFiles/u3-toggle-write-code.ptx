  <activity label="u3_ct_muc5" xml:id="u3_ct_muc5" numbered="yes" adaptive="yes" indentation="hide" language="java">
    <statement>
      <p>
        Every <c>PizzaOrder</c> shares the same price per slice, stored in the static variable <c>pricePerSlice</c>. Write a static method <c>setPricePerSlice</c> that takes a <c>double</c> <c>price</c> and changes <c>pricePerSlice</c> to it. Then write a <c>getTotal</c> method that returns the order's total cost: <c>slices</c> times <c>pricePerSlice</c>.
        The blocks below are mixed up and include extra blocks that are not
        needed. Drag the needed blocks from the left and put them in order on
        the right, with the right indentation. Click Check to check your
        solution.
      </p>
    </statement>

    <blocks>
      <block>
        <cline>public class PizzaOrder</cline>
        <cline>{</cline>
      </block>

      <block>
        <cline>    private int slices;</cline>
        <cline>    private static double pricePerSlice = 2.0;</cline>
      </block>

      <block>
        <cline>    public PizzaOrder(int slices)</cline>
        <cline>    {</cline>
      </block>

      <block>
        <cline>        this.slices = slices;</cline>
      </block>

      <block>
        <cline>    } // end constructor</cline>
      </block>

      <block>
        <choice correct="yes">
          <cline>    public static void setPricePerSlice(double price)</cline>
          <cline>    {</cline>
        </choice>

        <choice>
          <cline>    public void setPricePerSlice(double price)</cline>
          <cline>    {</cline>
        </choice>
      </block>

      <block>
        <choice correct="yes">
          <cline>        pricePerSlice = price;</cline>
        </choice>

        <choice>
          <cline>        this.pricePerSlice = price;</cline>
        </choice>
      </block>

      <block>
        <cline>    } // end setPricePerSlice</cline>
      </block>

      <block>
        <cline>    public double getTotal()</cline>
        <cline>    {</cline>
      </block>

      <block>
        <cline>        return slices * pricePerSlice;</cline>
      </block>

      <block>
        <cline>    } // end getTotal</cline>
      </block>

      <block>
        <cline>    public static void main(String[] args)</cline>
        <cline>    {</cline>
      </block>

      <block>
        <cline>        PizzaOrder small = new PizzaOrder(2);</cline>
        <cline>        PizzaOrder large = new PizzaOrder(6);</cline>
        <cline>        PizzaOrder.setPricePerSlice(2.5);</cline>
        <cline>        System.out.println(small.getTotal());</cline>
        <cline>        System.out.println(large.getTotal());</cline>
        <cline>        PizzaOrder.setPricePerSlice(3.0);</cline>
        <cline>        System.out.println(small.getTotal());</cline>
        <cline>        System.out.println(large.getTotal());</cline>
      </block>

      <block>
        <cline>    } // end main</cline>
      </block>

      <block>
        <cline>} // end class</cline>
      </block>
