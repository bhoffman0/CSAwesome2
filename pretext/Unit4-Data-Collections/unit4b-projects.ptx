    @Test
    public void test08() {
        String expected = "System.out.println(";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "main(String[] args");

            String[] lines = code.split("\n");

            for (String line : lines) {
                if (line.contains(expected)) {
                    actual += line + "\n";
                }
            }

            int times = actual.split("\n").length;
