        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        getResults("4+", actual, "System.out.println used at least 4 times", passed);
        assertTrue(passed);
    }

    @Test
    public void test09() {
        String expected = "Sum: 2546\nAverage: 50.92\nMaximum: 100\nMinimum: 2";
        String result = "";
        boolean passed = false;

        ArrayList&lt;Integer&gt; list1 = new ArrayList&lt;Integer&gt;(Arrays.asList(89, 97, 27, 27, 87, 16, 69, 19, 53, 71, 87, 23,
                3, 83, 36, 30, 52, 50, 72, 62, 21, 29, 31, 2, 67, 27, 61, 76, 30, 19, 48, 84, 98, 54, 92, 31, 75, 89,
                21, 94, 91, 12, 28, 69, 42, 67, 2, 100, 21, 12));
        String list = list1.toString();

        try {
            int sum = Main.sum(list1);
            double avg = Main.average(list1);
            int min = Main.minimum(list1);
            int max = Main.maximum(list1);

            result = "Sum: " + sum + "\nAverage: ";
            result += String.format("%.2f", avg);
            result += "\nMaximum: " + max + "\nMinimum: " + min;

            passed = result.equals(expected);
        } catch (Exception e) {
            result = "Error";
            passed = false;
        }

        getResults(expected, result, "Testing with values " + list, passed);
        assertTrue(passed);
    }

    @Test
    public void test10() {
        String expected = "Sum: 2641\nAverage: 52.82\nMaximum: 99\nMinimum: 0";
        String result = "";
        boolean passed = false;

        ArrayList&lt;Integer&gt; list1 = new ArrayList&lt;Integer&gt;(Arrays.asList(12, 87, 46, 9, 65, 49, 19, 24, 91, 60, 7, 46,
                16, 18, 72, 47, 94, 80, 77, 97, 3, 34, 32, 84, 99, 72, 64, 56, 50, 27, 77, 74, 59, 92, 2, 71, 41, 42,
                55, 14, 0, 82, 52, 96, 40, 2, 40, 96, 95, 74));
        String list = list1.toString();

        try {
            int sum = Main.sum(list1);
            double avg = Main.average(list1);
            int min = Main.minimum(list1);
            int max = Main.maximum(list1);

            result = "Sum: " + sum + "\nAverage: ";
            result += String.format("%.2f", avg);
            result += "\nMaximum: " + max + "\nMinimum: " + min;

            passed = result.equals(expected);
        } catch (Exception e) {
            result = "Error";
            passed = false;
        }

        getResults(expected, result, "Testing with values " + list, passed);
        assertTrue(passed);
    }

    private String getMethodCode(String code, String name) {
        String searchStr = code;
        int start = searchStr.indexOf(name);
        searchStr = searchStr.substring(start);

        int level = 0;

        for (int i = 0; i &lt; searchStr.length(); i++) {
            if (searchStr.substring(i, i + 1).equals("{")) {
                level++;
            } else if (searchStr.substring(i, i + 1).equals("}")) {
                level--;

                if (level == 0) {
                    // System.out.println(searchStr.substring(0, i+1).trim());
                    return searchStr.substring(0, i + 1).trim();
                }
            }
        }

        return searchStr.trim();
    }

    private boolean stringMatch(String str1, String str2) {
        str1 = str1.replaceAll(" ", "");
        str2 = str2.replaceAll(" ", "");

        return str1.contains(str2);
    }

    private String replaceTags(String str) {
        return str.replaceAll("&gt;", "&amp;gt;").replaceAll("&lt;", "&amp;lt;");
    }
}  
</tests>
</program>
</activity>
  

</subsection>

<subsection xml:id="unit4b-project3">
<title>Unit 4B Project 3 - List of Students</title>

<activity label="unit4b-project3-arraylist-students">
<statement>
<p>
  Create a program that uses ArrayLists with a Student class.  Leave Main alone for now and create a class called Student (do not make it public). Use the following specifications for the Student class:
</p>
<p>
<ul>
<li>A student should have a name and a grade level</li>
<li>Create a single one parameter constructor where the name is passed in as a parameter and the grade level is created randomly (9 - 12)</li>
<li>Create getters and setters for each instance variable and create a <c>toString</c> method</li>
</ul>  
</p>
<p>
  Back in Main, create an ArrayList of Students. Do the following:
</p>
<p>
<ul>
<li>Use a for loop to fill the ArrayList with 10 Students</li>
<li>You will need to prompt the user to add the name for each student</li>
<li>Create four more ArrayLists, one for each grade level, to hold Student objects</li>
<li>Fill each of these, using a for-each loop, with students from your original ArrayList with the corresponding grade level (all 9th grade students should be added to your ArrayList for 9th graders, all 10th grade students should be added to your ArrayList for 10th graders, and so on)</li>
<li>Print the number of students in each grade level using the size of the four grade level ArrayLists using four separate println statements</li>
<li>Be sure to label which grade level each number represents</li>
</ul>
</p>
</statement>
<program interactive="activecode" language="java">
<code>
import java.util.ArrayList;
import java.util.Scanner;

public class Main {
  public static void main(String[] args) {

  }
}

// create your Student class here - do not put the word public in front of the class name



</code>
<stdin>Bob Jane Sam Sue Jon Alice Peter Michael Joey Kate</stdin>
<tests>
import static org.junit.Assert.*;
import org.junit.*;

public class RunestoneTests extends CodeTestHelper {
    public RunestoneTests() {
        //super("Main", input1.replaceAll(" ", "\n")); // For Book
    }

    private static String input1 = "Bob Jane Sam Sue Jon Alice Peter Michael Joey Kate ";

    @Test
    public void test01() {
        String expected = "private";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "class Student");

            String[] lines = code.split("\n");

            for (String line : lines) {
                if (line.contains(expected)) {
                    actual += line + "\n";
                }
            }

            passed = actual.contains("int") &amp;&amp; actual.contains("String");
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        expected = "private String *;\nprivate int *;";
        getResults(expected, actual, "Instance variables created for Student class", passed);
        assertTrue(passed);
    }

    @Test
    public void test02() {
        String expected = "public Student";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "class Student");

            String[] lines = code.split("\n");

            for (String line : lines) {
                if (line.contains(expected) &amp;&amp; line.contains("String")) {
                    actual += line + "\n";
                }
            }

            passed = actual.split("\n").length == 1;
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        expected = "public Student(String *)";
        getResults(expected, actual, "Instance variables created for Student class", passed);
        assertTrue(passed);
    }

    @Test
    public void test03() {
        String expected = "Math.random()";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "public Student");

            String[] lines = code.split("\n");

            for (String line : lines) {
                if (line.contains(expected)) {
                    actual += line + "\n";
                }
            }

            boolean cast = stringMatch(actual, "(int)");
            boolean range = stringMatch(actual, "*4");
            boolean shift = stringMatch(actual, "+9");

            passed = cast &amp;&amp; range &amp;&amp; shift;
            actual += "Cast: " + cast + "\nRange: " + range + "\nShift: " + shift;
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        String expect = "Cast: true\nRange: true\nShift: true";

        getResults(expect, actual, "Math.random() used to create an integer in the range [9, 12]", passed);
        assertTrue(passed);
    }

    @Test
    public void test04() {

        String expected = "";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "class Student");

            String[] lines = code.split("\n");
            String getters = "";
            String setters = "";
            boolean name = false, grade = false;

            for (String line : lines) {
                if (line.contains("get") &amp;&amp; line.contains("public") &amp;&amp; line.contains("()")) {
                    getters += line.trim() + "\n";
                } else if (line.contains("set") &amp;&amp; line.contains("public void")) {
                    setters += line.trim() + "\n";
                    if (line.contains("Name") &amp;&amp; line.contains("String"))
                        name = true;
                    if (line.contains("GradeLevel") &amp;&amp; line.contains("int"))
                        grade = true;
                }
            }

            passed = getters.split("\n").length == 2 &amp;&amp; setters.split("\n").length == 2 &amp;&amp; name &amp;&amp; grade;
            actual = getters + setters;
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        expected = "public String getName()\npublic int getGradeLevel()\npublic void setName(String *)\npublic void setGradeLevel(int *)";
        getResults(expected, actual, "Accessors and Mutators created for Student class", passed);
        assertTrue(passed);
    }

    @Test
    public void test05() {
        String expected = "toString()";
        String actual = "";
        boolean passed = false;

        try {
