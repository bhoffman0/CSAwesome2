    @Test
    public void test06() {
        String expected = "Random results: true\nPrint double: 1\nPrint ints: 3";
        String actual = "";
        boolean passed = false;

        try {
            String output1 = getMethodOutput("main");
            String output2 = getMethodOutput("main");

            passed = !output1.equals(output2);

            String output = output1.replaceAll("[^\\.^0-9^\\n]", "");
            actual = "Random results: " + passed + "\n";
            int doubles = countOccurences(output, ".");
            int ints = output.split("\n").length - doubles;
            actual += "Print double: " + doubles + "\n";
            actual += "Print ints: " + ints;

            passed = expected.equals(actual);
        } catch (Exception e) {
