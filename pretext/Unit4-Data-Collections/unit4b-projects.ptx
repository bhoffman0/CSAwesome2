    @Test
    public void test07() {
        String expected = "for (";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "main(String[] args)");

            String[] lines = code.split("\n");
            boolean regFor = false, enhFor = false;

            for (String line : lines) {
                if (stringMatch(line, expected)) {
                    actual += line.trim() + "\n";
                    regFor = regFor || (line.contains("int") &amp;&amp; (line.contains(".size()") || line.contains("10")));
                    enhFor = enhFor || (line.contains("Student") &amp;&amp; line.contains(":"));
                }
            }

            passed = regFor &amp;&amp; enhFor;
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        expected = "for(int i = 0; i &lt; 10; i++)\nfor(Student * : *)";
        getResults(expected, actual, "At least 1 for loop and 1 enhanced for loop", passed);
        assertTrue(passed);
    }

    @Test
    public void test08() {
        String expected = "if (";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "main(String[] args)");

            String[] lines = code.split("\n");

            for (String line : lines) {
                if (stringMatch(line, expected)) {
                    actual += line.trim() + "\n";
                } else if (stringMatch(line, ".getGradeLevel()")) {
                    actual += line.trim() + "\n";
                }
            }

            boolean num = actual.split("\n").length &gt;= 4;
            boolean equals = countOccurences(actual, "==") == 4;
            boolean gets = countOccurences(actual, ".getGradeLevel()") &gt;= 1;
            boolean grades = actual.contains("9") &amp;&amp; actual.contains("10") &amp;&amp; actual.contains("11")
                    &amp;&amp; actual.contains("12");
            passed = num &amp;&amp; equals &amp;&amp; gets &amp;&amp; grades;
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        expected = "if x 4\n== x 4\ngrades: 9-12\n.getGradeLevel()";
        getResults(expected, actual, "if statements used to determine which grade level ArrayList to add students to",
                passed);
        assertTrue(passed);
    }

    @Test
    public void test09() {
        String actual = "";
        String expected = "Number of ninth graders: 4\n" +
                "Number of tenth graders: 2\n" +
                "Number of eleventh graders: 2\n" +
                "Number of twelfth graders: 2";
        boolean passed = false;

        try {
            String className = "StudentsTest1";
            String code = getCode();

            if (code.contains("new ArrayList")) {

                code = code.replace("Main", className).replace("public class", "class");
                int iFor = code.indexOf("for(int");

                if (iFor == -1)
                    iFor = code.indexOf("for (int");
                int iEnd = code.indexOf("}", iFor) + 1;

                int inAL = code.indexOf("&lt;Student&gt;");
                int inEq = code.indexOf("=", inAL);
                String name = code.substring(inAL, inEq).split(" ")[1].trim();

                String newCode = "\n\ns.get(0).setGradeLevel(12);\n  s.get(1).setGradeLevel(9);\n  s.get(2).setGradeLevel(11);\n  s.get(3).setGradeLevel(9);\n  s.get(4).setGradeLevel(9);\n  s.get(5).setGradeLevel(10);\n  s.get(6).setGradeLevel(10);\n  s.get(7).setGradeLevel(9);\n  s.get(8).setGradeLevel(11);\n  s.get(9).setGradeLevel(12);";
                newCode = newCode.replaceAll("s.get", name + ".get");

                code = code.substring(0, iEnd) + newCode + code.substring(iEnd + 1);

                String output = getMethodOutputChangedCodeWithInput(code, className, "main",
                        input1.replaceAll(" ", "\n"));

                String[] lines = output.split("\n");

                for (String line : lines) {
                    if (line.matches(".*\\d"))
                        actual += line + "\n";
                }

            }
            String values = actual.replaceAll("\\D", "");

            passed = values.equals("4222");
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        getResults(expected, actual, "Correct output for test case 1", passed);
        assertTrue(passed);
    }

    @Test
    public void test10() {
        String actual = "";
        String expected = "Number of ninth graders: 3\n" +
                "Number of tenth graders: 4\n" +
                "Number of eleventh graders: 1\n" +
                "Number of twelfth graders: 2";
        boolean passed = false;

        try {
            String className = "StudentsTest2";
            String code = getCode();

            if (code.contains("new ArrayList")) {

                code = code.replace("Main", className).replace("public class", "class");
                int iFor = code.indexOf("for(int");

                if (iFor == -1)
                    iFor = code.indexOf("for (int");

                int iEnd = code.indexOf("}", iFor) + 1;

                int inAL = code.indexOf("&lt;Student&gt;");
                int inEq = code.indexOf("=", inAL);
                String name = code.substring(inAL, inEq).split(" ")[1].trim();
                // System.out.println(name);

                String newCode = "\n\ns.get(0).setGradeLevel(10);\n  s.get(1).setGradeLevel(11);\n  s.get(2).setGradeLevel(9);\n  s.get(3).setGradeLevel(9);\n  s.get(4).setGradeLevel(10);\n  s.get(5).setGradeLevel(10);\n  s.get(6).setGradeLevel(12);\n  s.get(7).setGradeLevel(9);\n  s.get(8).setGradeLevel(12);\n  s.get(9).setGradeLevel(10);";
                newCode = newCode.replaceAll("s.get", name + ".get");

                code = code.substring(0, iEnd) + newCode + code.substring(iEnd + 1);
                // System.out.println(code);

                String output = getMethodOutputChangedCodeWithInput(code, className, "main",
                        input1.replaceAll(" ", "\n"));

                String[] lines = output.split("\n");

                for (String line : lines) {
                    if (line.matches(".*\\d"))
                        actual += line + "\n";
                }
            }

            String values = actual.replaceAll("\\D", "");

            passed = values.equals("3412");
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        getResults(expected, actual, "Correct output for test case 2", passed);
        assertTrue(passed);
    }

    private String getMethodCode(String code, String name) {
        String searchStr = code;
        int start = searchStr.indexOf(name);
        searchStr = searchStr.substring(start);

        int level = 0;

        for (int i = 0; i &lt; searchStr.length(); i++) {
            if (searchStr.substring(i, i + 1).equals("{")) {
                level++;
            } else if (searchStr.substring(i, i + 1).equals("}")) {
                level--;

                if (level == 0) {
                    // System.out.println(searchStr.substring(0, i+1).trim());
                    return searchStr.substring(0, i + 1).trim();
                }
            }
        }

        return searchStr.trim();
    }

    private boolean stringMatch(String str1, String str2) {
        str1 = str1.replaceAll(" ", "");
        str2 = str2.replaceAll(" ", "");

        return str1.contains(str2);
    }
}
