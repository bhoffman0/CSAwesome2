        }

        getResults(expected, actual, "Output includes results from random values", passed);
        assertTrue(passed);
    }

    @Test
    public void test07() {
        String expected = "sum(*)\naverage(*)\nmaximum(*)\nminimum(*)";
        String actual = "";
        boolean passed = false;

        try {
