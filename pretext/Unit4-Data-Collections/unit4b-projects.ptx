<tests>
import static org.junit.Assert.*;
import org.junit.*;
import java.util.Arrays;
import java.util.ArrayList;

public class RunestoneTests extends CodeTestHelper {
    public RunestoneTests() {
        super("Main");
    }

    @Test
    public void test01() {
        String expected = "ArrayList&lt;Integer&gt;";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "main(String[] args)");

            String[] lines = code.split("\n");

            for (String line : lines) {
                if (line.contains(expected)) {
                    actual += line + "\n";
                }
            }

            passed = stringMatch(actual, "new " + expected + "()")
                    || stringMatch(actual, "new ArrayList&lt;&gt;()");
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        expected = expected + " * = new " + expected + "()";
        getResults(replaceTags(expected), replaceTags(actual), "ArrayList of Integers created properly", passed);
        assertTrue(passed);
    }

    @Test
    public void test02() {
        String expected = "Math.random()";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "main(String[] args)");

            String[] lines = code.split("\n");

            for (String line : lines) {
                if (line.contains(expected)) {
                    actual += line + "\n";
                }
            }

            boolean cast = stringMatch(actual, "(int)");
            boolean range = stringMatch(actual, "*101");

            passed = cast &amp;&amp; range;
            actual += "Cast: " + cast + "\nRange: " + range;
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        String expect = "Cast: true\nRange: true";
        getResults(expect, actual, "Math.random() used to create an integer in the range [0, 100]", passed);
        assertTrue(passed);
    }

    @Test
    public void test03() {
        String expected = "for";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "main(String[] args)");
            code = getMethodCode(code, "for");

            String[] lines = code.split("\n");

            boolean loop = false;

            for (String line : lines) {
                if (line.contains(expected) &amp;&amp; line.contains("50")) {
                    actual += line + "\n";
                    loop = true;
                } else if (loop &amp;&amp; line.contains(".add(")) {
                    actual += line + "\n";
                    break;
                }
            }

            passed = stringMatch(actual, "for (int") &amp;&amp; actual.contains("++") &amp;&amp; actual.contains(".add(");
            boolean pass2 = stringMatch(actual, "= 0") &amp;&amp; stringMatch(actual, "&lt; 50");
            boolean pass3 = stringMatch(actual, "= 1") &amp;&amp; stringMatch(actual, "&lt;= 50");
            boolean pass4 = pass2 || pass3;
            passed = passed &amp;&amp; pass4;
        } catch (Exception e) {
            actual = "Error";
            passed = false;
        }

        expected = "for(int i = 0; i &lt; 50; i++)\n\t*.add(*)";
        getResults(expected, actual, "50 random integers are added to the ArrayList using a for loop", passed);
        assertTrue(passed);
    }

    @Test
    public void test04() {
        String expected = "public static: 4\nint Return type: 3\n";
        expected += "Return type double: 1\nParameters: 4";
        String actual = "";
        String result = "";
        boolean passed = false;

        try {
            String code = getCode();

            String[] lines = code.split("\n");

            for (String line : lines) {
                if (line.contains("public static ") &amp;&amp; !line.contains("main")) {
                    actual += line + "\n";
                }
            }

            int num = actual.split("\n").length;
            int ints = countOccurences(actual, "static int");
            int doubles = countOccurences(actual, "double");
            int params = countOccurences(actual, "(ArrayList&lt;Integer&gt;");

            result = "public static: " + num + "\nint Return type: " + ints + "\n";
            result += "Return type double: " + doubles + "\nParameters: " + params;

            passed = result.contains(expected);

        } catch (Exception e) {
