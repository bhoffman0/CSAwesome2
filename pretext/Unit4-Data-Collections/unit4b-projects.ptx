        getResults(expected, result, "Method headers", passed);
        assertTrue(passed);
    }

    @Test
    public void test05() {
        String expected = "sum\naverage\nmaximum\nminimum";
        String output = "";
        boolean passed = false;

        try {
            output = getMethodOutput("main");

            boolean sum = stringMatch(output, "sum");
            boolean avg = stringMatch(output, "average");
