    <tests>
import static org.junit.Assert.assertTrue;
import org.junit.Test;

public class RunestoneTests extends CodeTestHelper
{
    // Correct class header
    @Test
    public void test01() {
        boolean passed = false;
        String expected = "class LibraryBook";
        String actual = "";

        try {
            String code = getCode();
            String[] lines = code.split("\n");
            passed = code.contains(expected);

            for (String line : lines) {
                if (line.contains("class") &amp;&amp; !line.contains("Main") &amp;&amp; !line.contains("Tester")){
                    actual = line;
                    break;
                }
            }
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "Created LibraryBook class header correctly", passed);
        assertTrue(passed);
    }

