            for (String line : lines) {
                if (line.contains("getAverageScore()") || line.contains("getRank()"))
                    actual += line.trim() + "\n";
            }
            
            passed = stringMatch(actual, "getAverageScore()") &amp;&amp; stringMatch(actual, "getRank()");
        } catch (Exception e) {
