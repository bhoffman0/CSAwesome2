        getResults(expected, actual, "Constructor sets all instance variables correctly", passed);
        assertTrue(passed);
    }
    
    // getAverageScore method avoids int division and division by 0
    @Test
    public void test04() {
        String expected = "if (gamesPlayed == 0)\nreturn 0.0;\nreturn (double) totalPoints / gamesPlayed;";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "public double getAverageScore(");
            String[] lines = code.split("\n");
            
            for (String line : lines) {
                if (line.contains("return") || line.contains("if"))
                    actual += line.trim() + "\n";
            }
            
            passed = stringMatch(actual, "==0") &amp;&amp; stringMatch(actual, "return0.0") &amp;&amp; stringMatch(actual, "(double)");
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "getAverageScore method avoids int division and division by 0", passed);
        assertTrue(passed);
    }

    // completeGame method increments gamesPlayed by 1, adds parameter to totalPoints, and checks if isActive should be false
    @Test
    public void test05() {
        String expected = "gamesPlayed++;\ntotalPoints += pts;\nif (gamesPlayed &gt;= 20)\nisActive = false;";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "public void completeGame(");
            String[] lines = code.split("\n");

            String param = code.substring(code.indexOf("(")+1, code.indexOf(")")).trim();
            param = param.split(" ")[1];
            
            for (String line : lines) {
                if (line.contains("+") || line.contains("=") || line.contains("&gt;"))
                    actual += line.trim() + "\n";
            }

            boolean increment = stringMatch(actual, "++") || stringMatch(actual, "+=1") || stringMatch(actual, "+1");
            boolean addition = stringMatch(actual, "+=" + param) || stringMatch(actual, "+" + param);
            boolean condition = stringMatch(actual, "&gt;=20") || stringMatch(actual, "&gt;19");
            boolean ifactive = stringMatch(actual, "=false");
            
            passed = increment &amp;&amp; addition &amp;&amp; condition &amp;&amp; ifactive;
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "completeGame method increments gamesPlayed by 1, adds parameter to total points, and checks if isActive should be false", passed);
        assertTrue(passed);
    }

    // getRank method calls getAverageScore method correctly
    @Test
    public void test06() {
        String expected = "getAverageScore();";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "public String getRank(");
            String[] lines = code.split("\n");
            
            for (String line : lines) {
                if (line.contains("getAverageScore()"))
                    actual += line.trim() + "\n";
            }
            
            passed = stringMatch(actual, "getAverageScore()");
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "getRank method calls getAverageScore method", passed);
        assertTrue(passed);
    }

