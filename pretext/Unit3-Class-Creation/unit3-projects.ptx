        assertTrue(passed);
    }

    // toString method returns a correctly formatted String
    @Test
    public void test10() {
        String expected = "{username}: Games Played = {gamesPlayed}, Average Score = {average}, Rank = {rank}";
        String actual = "";
        boolean passed = false;

        try {
            GamePlayer p1 = new GamePlayer("GameMaster");
            p1.completeGame(75);
            p1.completeGame(125);
            p1.completeGame(200);
            actual = p1.toString();
                        
            passed = stringMatch(actual, "GameMaster") &amp;&amp; stringMatch(actual, "Games Played = 3") &amp;&amp; stringMatch(actual, "Average Score = 133.33") &amp;&amp; stringMatch(actual, "Rank = Advanced");
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "toString method returns a correctly formatted String", passed);
        assertTrue(passed);
    }

    private String getMethodCode(String code, String name) {
        String searchStr = code;
        int start = searchStr.indexOf(name);
        searchStr = searchStr.substring(start);

        int level = 0;

        for (int i = 0; i &lt; searchStr.length(); i++) {
            if (searchStr.substring(i,i+1).equals("{")) {
                level++;
            } else if (searchStr.substring(i,i+1).equals("}")) {
                level--;

                if (level == 0) {
                    //System.out.println(searchStr.substring(0, i+1).trim());
                    return searchStr.substring(0, i+1).trim();
                }
            }
        }

        return searchStr.trim();
    }

    private int countVariables(String[] lines, String type) {
        int num = 0;
        for (String line : lines){
            if (line.contains(type)) {
                if (line.contains(",")) {
                    num += line.split(",").length;
                } else {
                    num++;
                }
            }
        }
        return num;
    }

    private boolean stringMatch(String str1, String str2) {
        str1 = str1.replaceAll(" ", "");
        str2 = str2.replaceAll(" ", "");

        return str1.contains(str2);
    }
} 
   
