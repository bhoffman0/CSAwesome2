            actual = "private: "+ num; // Str+"\nprivate int: " + numInt;
            passed = num &gt;= 3; // &amp;&amp; numStr &gt;= 2 &amp;&amp; numInt &gt;=1;
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "Created three private variables", passed);
        assertTrue(passed);
    }
    
    // 3 instance variables that are 2 Strings and 1 int
