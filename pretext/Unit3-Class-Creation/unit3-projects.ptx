            actual = "Error";
        }

        getResults(expected, actual, "The getTitle and getBorrowDays methods return the value of the correct instance variables", passed);
        assertTrue(passed);
    }

    // The extendBorrow method updates the int variable by the parameter value
    @Test
    public void test09() {
        String expected = "borrowDays += num;";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "public void extendBorrow(");

            for (String line : code.split("\n")) {
                if (line.contains("+="))
                    actual += line.trim() + "\n";
            }
            
            passed = actual.split("\n").length == 1;
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "The extendBorrow method updates the int variable by the parameter value", passed);
        assertTrue(passed);
    }

    // The getDescription method returns a correctly formatted String
    @Test
    public void test10() {
        String expected = "{title} by {author} can be borrowed for {borrowDays} days.";
        String actual = "";
        boolean passed = false;

        try {
            LibraryBook book = new LibraryBook("The Book Thief", "Markus Zusak", 21);
            actual = book.getDescription();
            LibraryBook book2 = new LibraryBook("The Giver", "Lois Lowry", 14);
            actual += "\n" + book2.getDescription();

            passed = actual.contains("The Book Thief") &amp;&amp; actual.contains("Markus Zusak") &amp;&amp; actual.contains("21") &amp;&amp; actual.contains("The Giver") &amp;&amp; actual.contains("Lois Lowry") &amp;&amp; actual.contains("14");
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "The getDescription method returns a correctly formatted String", passed);
        assertTrue(passed);
    }

    private String getMethodCode(String code, String name) {
        String searchStr = code;
        int start = searchStr.indexOf(name);
        searchStr = searchStr.substring(start);

        int level = 0;

        for (int i = 0; i &lt; searchStr.length(); i++) {
            if (searchStr.substring(i,i+1).equals("{")) {
                level++;
            } else if (searchStr.substring(i,i+1).equals("}")) {
                level--;

                if (level == 0) {
                    //System.out.println(searchStr.substring(0, i+1).trim());
                    return searchStr.substring(0, i+1).trim();
                }
            }
        }

        return searchStr.trim();
    }

    private int countVariables(String[] lines, String type) {
        int num = 0;
        for (String line : lines){
            if (line.contains(type)) {
                if (line.contains(",")) {
                    num += line.split(",").length;
                } else {
                    num++;
                }
            }
        }
        return num;
    }

    private boolean stringMatch(String str1, String str2) {
        str1 = str1.replaceAll(" ", "");
        str2 = str2.replaceAll(" ", "");

        return str1.contains(str2);
    }
}

    </tests>
  </program>
</activity>

