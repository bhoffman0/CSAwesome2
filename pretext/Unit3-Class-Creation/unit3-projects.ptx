            for (String line : lines) {
                if (line.contains("public LibraryBook("))
                    actual += line + "\n";
            }
            
            actual = actual.trim();
            
            String line = actual.substring(actual.indexOf("(")+1, actual.indexOf(")"));
            
            int numStr = countOccurences(line, "String");
            int numInt = countOccurences(line, "int");
  
            passed = numStr &gt;= 2 &amp;&amp; numInt &gt;= 1;
