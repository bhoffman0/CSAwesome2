    }

    // toString calls the getAverageScore and getRank methods correctly
    @Test
    public void test09() {
        String expected = "getAverageScore()\ngetRank()";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "public String toString(");
