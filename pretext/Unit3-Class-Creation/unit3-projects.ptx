        System.out.println(book1.getBorrowDays());
        System.out.println(book1.getDescription());

        LibraryBook book2 = new LibraryBook("Holes", "Louis Sachar", 10);
        System.out.println(book2.getDescription());
        book2.extendBorrow(5);
        System.out.println(book2.getBorrowDays());
