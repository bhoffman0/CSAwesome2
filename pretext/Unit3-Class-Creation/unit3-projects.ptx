                    actual = line;
                    break;
                }
            }
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "Created GamePlayer class header correctly", passed);
        assertTrue(passed);
    }

    // Instance variables are private
    @Test
    public void test02() {
        String expected = "private: 4";
        String actual = "";
        boolean passed = false;

        try {

            String code = getCode();
            String[] lines = code.split("\n");

            int num = countVariables(lines, "private");
            //int numStr = countVariables(lines, "private String");
            //int numInt = countVariables(lines, "private int");

            actual = "private: "+ num; // Str+"\nprivate int: " + numInt;
            passed = num &gt;= 4; // &amp;&amp; numStr &gt;= 2 &amp;&amp; numInt &gt;=1;
        } catch (Exception e) {
            actual = "Error";
        }

        getResults(expected, actual, "Created four private variables", passed);
        assertTrue(passed);
    }
    
    // Constructor sets all instance variables correctly
    @Test
    public void test03() {
        String expected = "username = u;\ngamesPlayed = 0;\ntotalPoints = 0;\nisActive = true;";
        String actual = "";
        boolean passed = false;

        try {
            String code = getCode();
            code = getMethodCode(code, "public GamePlayer(");
            String[] lines = code.split("\n");
            
            for (String line : lines) {
                if (line.contains("="))
                    actual += line.trim() + "\n";
            }
            
